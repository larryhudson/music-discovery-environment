# Optional: Last.fm read-only API key and listening-history username.
LASTFM_API_KEY=
LASTFM_USERNAME=

# Exa Search API: https://dashboard.exa.ai/api-keys
EXA_SEARCH_API_KEY=

# Headless Pi summarizer model (non-secret; requires existing Pi authentication).
PI_SUMMARY_MODEL=opencode-go/deepseek-v4.1-flash
